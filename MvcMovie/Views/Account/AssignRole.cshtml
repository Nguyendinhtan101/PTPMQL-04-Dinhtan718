@using MvcMovie.Models.ViewModels
@model AssignRoleVM

<h2>Assign Role</h2>
<hr>

@if (Model != null && Model.AllRoles != null)
{
    <form asp-action="AssignRole" method="post">
        @foreach (var role in Model.AllRoles)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       id="@role.Id"
                       name="SelectedRoles"
                       value="@role.Name"
                       @(Model.SelectedRoles != null && Model.SelectedRoles.Contains(role.Name) ? "checked" : "") />
                <label class="form-check-label" for="@role.Id">@role.Name</label>
            </div>
        }

        <input type="hidden" name="UserId" value="@Model.UserId" />
        <button type="submit" class="btn btn-primary mt-3">Assign Roles</button>
    </form>
}
else
{
    <div class="alert alert-danger">
        Dữ liệu phân quyền chưa được khởi tạo đúng.
    </div>
}
